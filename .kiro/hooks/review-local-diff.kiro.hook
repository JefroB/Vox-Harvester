{
  "enabled": true,
  "name": "Review Local Dev Diff",
  "description": "Asks Kiro to review the diff between main and local-dev branches, focusing on logic, security, and edge cases.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `git diff main..local-dev` and review the changes. Focus on logic errors, security issues, and edge cases. Flag issues with severity levels (critical, warning, suggestion). If the code is acceptable, say so briefly. Do not rewrite for style unless it violates architecture."
  }
}